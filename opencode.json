{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 5120
  },
  "compaction": {
    "auto": true,
    "tail_turns": 12
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@context7/mcp"],
      "enabled": true
    }
  }
}